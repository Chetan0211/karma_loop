<!--
params used here:
chat
current_user
-->
<% reactions = chat.reactions_by_emoji %>
<% show_reactors = chat.group.group_users.count > 2 %>
<div id="chat_<%= chat.id %>_reactions" class="chat-reactions flex justify-end">
  <% if reactions.any? %>
    <div class="relative -mt-2 mr-2 z-10" x-data="{ reactorsOpen: false }" @click.outside="reactorsOpen = false">
      <button type="button"
        <% if show_reactors %>@click="reactorsOpen = !reactorsOpen"<% end %>
        class="flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-xs shadow-sm bg-[var(--background-clr-thick)] border border-[var(--border-clr-subtle)] <%= show_reactors ? "cursor-pointer hover:bg-[var(--background-clr-strong)]" : "cursor-default" %>">
        <% reactions.each_key do |emoji| %>
          <span><%= emoji %></span>
        <% end %>
        <% total = reactions.values.sum(&:size) %>
        <% if total > 1 %>
          <span class="ml-0.5 font-semibold text-[var(--txt-clr-muted)]"><%= total %></span>
        <% end %>
      </button>
      <% if show_reactors %>
        <div x-show="reactorsOpen" x-cloak x-transition
          class="absolute bottom-full right-0 mb-1 z-20 w-48 max-h-60 overflow-y-auto p-2 space-y-1 rounded-lg shadow-lg bg-[var(--background-clr-clear)] border border-[var(--border-clr-subtle)]">
          <% reactions.each do |emoji, users| %>
            <% users.each do |user| %>
              <div class="flex items-center justify-between text-sm text-[var(--txt-clr-default)]">
                <span class="truncate"><%= user.id == current_user.id ? "You" : user.username %></span>
                <span class="ml-2"><%= emoji %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
