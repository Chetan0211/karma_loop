<!--
params used here:
current_user
chat

-->
<div id="<%= chat.id %>" class="flex max-w-full items-center chat-message" :class="<%= current_user.id == chat.user_id %> ? 'justify-end' : 'justify-start'" data-date="<%= chat.created_at.to_date %>" data-chat-read="<%= chat.user_read?(current_user) %>" data-read-url="<%= message_read_path(chat_id: chat.id) %>" >
  <div class="group flex max-w-full items-center" :class="<%= current_user.id == chat.user_id %> ? 'flex-row-reverse' : 'flex-row'">
    <!-- Message Bubble -->
    <div class="max-w-[80%] lg:max-w-md message-bubble">
      <div class="px-4 py-2 overflow-hidden rounded-2xl" :class="<%= current_user.id == chat.user_id %> ? 'bg-[var(--background-clr-clear)] text-[var(--txt-clr-default)] rounded-br-none' : 'bg-[var(--background-clr-strong)] text-[var(--txt-clr-default)] rounded-bl-none'">
        <!-- ** MODIFIED: Quoted Reply UI ** -->
        <% if chat.reply_to.present? %>
          <div x-show="<%= chat.reply_to.present? %>" data-action="click->chat#scrollToMessage" data-reply-to-id="<%= chat.reply_to.id %>" class="reply-container cursor-pointer max-h-32 overflow-hidden mb-2 p-2 rounded-md border-l-4" :class="<%= current_user.id == chat.user_id %> ? 'bg-[var(--background-clr-strong)]' : 'bg-[var(--background-clr-clear)] border-[var(--border-clr-thick)]'">
            <p class="text-xs font-semibold text-[var(--primary-500)]"><%= (current_user.id == chat.reply_to.user.id) ? "You" : chat.reply_to.user.username %></p>
            <%= render partial: "chat/chat_attachments", locals:{chat: chat.reply_to, reply: true} %>
            <% if chat.reply_to.message.present? %>
              <p class="text-xs italic truncate text-[var(--txt-clr-muted)]"
                 data-controller="message-decryption"
                 data-encrypted-message="<%= chat.reply_to.message %>"
                 data-message-decryption-display-value="reply"
                 data-decryption-target="placeholder">
                decrypting...
              </p>
            <% end %>
          </div>
        <% end %>
        <!-- Main Message Text -->
        <%= render partial: "chat/chat_attachments", locals:{chat: chat} %>
        <% if chat.message.present? %>
          <p class="text-sm break-words"
             data-controller="message-decryption"
             data-encrypted-message="<%= chat.message %>"
             data-message-decryption-display-value="full"
             data-decryption-target="placeholder">
            decrypting...
          </p>
        <% end %>
        <%= render partial: "chat/chat_seen_status", locals:{chat: chat, current_user: current_user} %>
      </div>
      <!-- Reactions Display -->
      <%= render partial: "chat/chat_reactions", locals:{chat: chat, current_user: current_user} %>
    </div>
    <!-- Message Actions (Reply, React) -->
    <div class="flex-shrink-0 flex items-center space-x-1 p-1 md:opacity-0 group-hover:opacity-100 transition-opacity mx-2">
      <button @click="showReplyBanner = true" data-action="click->chat#replyMessage" data-chat-id="<%= chat.id %>" data-username="<%= (current_user.id == chat.user_id) ? "You" : chat.user.username %>" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-[var(--background-clr-strong)]"><%= icon(icon: :reply_icon, options:{class: "text-xs text-[var(--txt-clr-muted)]"}) %></button>
      <!-- Reactions selection -->
      <div x-data="{ reactionsOpen: false }" @click.outside="reactionsOpen = false" class="relative">
        <button type="button" @click="reactionsOpen = !reactionsOpen" aria-label="React" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-[var(--background-clr-strong)]"><%= icon(icon: :face_smile_icon_regular, options:{class: "text-xs text-[var(--txt-clr-muted)]"}) %></button>
        <div x-show="reactionsOpen" x-cloak x-transition class="absolute bottom-full mb-2 z-20 flex space-x-1 bg-[var(--background-clr-clear)] shadow-lg rounded-full p-1" :class="<%= current_user.id == chat.user_id %> ? 'left-0' : 'right-0'">
          <% Chat::QUICK_REACTIONS.each do |emoji| %>
            <button type="button" @click="reactionsOpen = false" data-action="click->chat#react" data-url="<%= create_message_reaction_path %>" data-chat-id="<%= chat.id %>" data-reaction="<%= emoji %>" class="text-lg p-1 rounded-full hover:bg-[var(--background-clr-strong)]"><%= emoji %></button>
          <% end %>
          <button type="button" @click="reactionsOpen = false" data-action="click->reaction-picker#open" data-reaction-picker-chat-id-param="<%= chat.id %>" title="More reactions" aria-label="More reactions" class="w-9 h-9 flex items-center justify-center rounded-full text-[var(--txt-clr-muted)] hover:bg-[var(--background-clr-strong)]"><%= icon(icon: :plus_icon) %></button>
        </div>
      </div>
    </div>
  </div>
</div>